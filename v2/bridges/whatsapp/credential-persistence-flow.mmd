%%{init: {"theme": "base", "themeVariables": {"fontFamily": "ui-sans-serif, system-ui, sans-serif", "primaryTextColor": "#172033", "lineColor": "#64748b", "edgeLabelBackground": "#ffffff"}, "flowchart": {"curve": "basis", "nodeSpacing": 40, "rankSpacing": 54}}}%%
flowchart LR
    CHANGE["Baileys key / credential<br/>mutation burst"]
    COALESCE["Credential publisher<br/>one in flight · one dirty follow-up"]
    SNAP["Newest complete snapshot<br/>+ prior fingerprint"]
    CAS{"Active package instance<br/>and fingerprint match?"}
    STORE[("Owner-private<br/>credential snapshot")]
    ACK{"Durable acknowledgement<br/>dirty again?"}
    DONE["Resolve every waiter<br/>through this drain"]
    FATAL["Fail package instance<br/>no stale retry"]
    RESTART["Supervisor restarts from<br/>last acknowledged snapshot"]

    CHANGE -->|"mark dirty"| COALESCE --> SNAP --> CAS
    CAS -->|"yes · atomic replace"| STORE --> ACK
    ACK -->|"yes"| SNAP
    ACK -->|"no"| DONE
    CAS -->|"no / error"| FATAL --> RESTART --> STORE

    classDef input fill:#f3e8ff,stroke:#9333ea,stroke-width:2px,color:#581c87;
    classDef runtime fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#172554;
    classDef durable fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d;
    classDef gate fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f;
    classDef failure fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    class CHANGE input;
    class COALESCE,SNAP,DONE runtime;
    class STORE durable;
    class CAS,ACK gate;
    class FATAL,RESTART failure;
