{
  "schema": 1,
  "agents": [
    {
      "agentId": "claude-opus",
      "displayName": "Claude Opus 5",
      "executable": "npx",
      "arguments": ["--yes", "@agentclientprotocol/claude-agent-acp@0.70.0"],
      "environmentFrom": ["PATH", "CLAUDE_CODE_OAUTH_TOKEN"],
      "sessionOptions": {
        "mode": "bypassPermissions",
        "model": "opus"
      },
      "sessionMcpServers": [
        {
          "name": "crab-sub-agents",
          "executable": "../target/release/crab-v2-sub-agent-mcp",
          "arguments": [],
          "environmentFrom": []
        },
        {
          "name": "crab-bridges",
          "executable": "../target/release/crab-v2-bridge-mcp",
          "arguments": [],
          "environmentFrom": []
        }
      ],
      "protocol": "v1",
      "authorityProbe": {
        "executable": "../target/release/crab-v2-claude-authority-probe",
        "arguments": [],
        "environmentFrom": []
      }
    }
  ],
  "channels": [
    {
      "channelId": "primary",
      "adapterId": "native-ui",
      "agentId": "claude-opus",
      "workingDirectory": "/absolute/path/to/agent-workspace",
      "nativeChannel": { "title": "Claude Opus 5" },
      "sessionMetadata": {},
      "lane": "primary"
    }
  ],
  "lanes": [
    {
      "lane": "primary",
      "workerId": "crab-v2-primary",
      "batchLimit": 16,
      "leaseDurationMs": 30000,
      "retryDelayMs": 1000,
      "maxAttempts": 3,
      "pollIntervalMs": 100
    }
  ],
  "bridges": []
}
