{
  "schema": 1,
  "agents": [
    {
      "agentId": "primary-agent",
      "displayName": "Primary ACP agent",
      "executable": "/absolute/path/to/acp-agent",
      "arguments": ["--acp", "--no-sandbox", "--yolo"],
      "environmentFrom": ["AGENT_API_TOKEN"],
      "protocol": "v2",
      "authorityProbe": {
        "executable": "/absolute/path/to/authority-probe",
        "arguments": [],
        "environmentFrom": []
      }
    }
  ],
  "channels": [
    {
      "channelId": "primary",
      "adapterId": "native-ui",
      "agentId": "primary-agent",
      "workingDirectory": "/absolute/path/to/agent-workspace",
      "nativeChannel": { "title": "Primary" },
      "sessionMetadata": {},
      "lane": "primary"
    }
  ],
  "lanes": [
    {
      "lane": "primary",
      "workerId": "crab-v2-primary",
      "batchLimit": 16,
      "leaseDurationMs": 30000,
      "retryDelayMs": 1000,
      "maxAttempts": 3,
      "pollIntervalMs": 100
    }
  ],
  "bridges": [
    {
      "bridgeId": "whatsapp",
      "packageId": "crab.whatsapp",
      "displayName": "WhatsApp",
      "executable": "../bridges/whatsapp/src/index.js",
      "arguments": [],
      "environmentFrom": ["PATH"],
      "workingDirectory": "../bridges/whatsapp",
      "configuration": {
        "targetChannelId": "primary",
        "browserName": "Crab"
      },
      "authenticationMethods": ["qrCode", "phoneCode"],
      "ingressMode": "queue",
      "desiredRunning": true,
      "healthIntervalMs": 5000,
      "credentialValidationIntervalMs": 3600000,
      "restartLimit": 5,
      "restartWindowMs": 300000
    }
  ]
}
