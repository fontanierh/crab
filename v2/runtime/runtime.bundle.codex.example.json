      "sessionOptions": {
        "mode": "agent-full-access",
        "model": "gpt-5.6-sol",
        "reasoning_effort": "high"
      },
      "sessionMcpServers": [
        {
          "name": "crab-sub-agents",
          "executable": "../bin/crab-v2-sub-agent-mcp",
          "arguments": [],
          "environmentFrom": []
