        {
          "name": "crab-bridges",
          "executable": "../bin/crab-v2-bridge-mcp",
          "arguments": [],
          "environmentFrom": []
        }
      ],
      "protocol": "v1",
      "authorityProbe": {
        "executable": "../bin/crab-v2-codex-authority-probe",
        "arguments": [
          "--adapter-relative-to-probe",
          "../agents/codex/node_modules/.bin/codex-acp"
        ],
        "environmentFrom": []
      }
    }
  ],
  "channels": [
    {
      "channelId": "primary",
      "adapterId": "native-ui",
