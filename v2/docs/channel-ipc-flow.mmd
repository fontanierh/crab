flowchart TB
    UI["T3 provider or native UI"]
    PRODUCER["cron · self-work · operator<br/>crab-v2-trigger"]
    AUTH["0600 token<br/>version · request ID · bounded frame"]
    LIMIT["Server admission<br/>64 active · 30s lifetime"]
    IPC["Crab local IPC<br/>canonical Boxology JSON"]
    GATEWAY["channel-gateway<br/>attach · reuse · recover"]
    INBOX["trigger-inbox<br/>durable · idempotent enqueue"]
    ROUTER["turn-router<br/>lane · mode · settle"]
    CHANNEL["native-channel<br/>turn · interrupt · status · replay"]
    HOST["agent-host<br/>Crab-owned ACP process"]

    UI --> AUTH --> LIMIT --> IPC
    PRODUCER --> AUTH
    IPC -->|"attach"| GATEWAY
    IPC <-->|"native operations"| CHANNEL
    IPC -->|"enqueue"| INBOX --> ROUTER --> CHANNEL
    GATEWAY --> CHANNEL
    GATEWAY --> HOST
    CHANNEL <--> HOST
    UI -. "disconnect: session stays live" .-> HOST

    classDef client fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#172033;
