%%{init: {"theme": "base", "themeVariables": {"fontFamily": "ui-sans-serif, system-ui, sans-serif", "primaryTextColor": "#172033", "lineColor": "#64748b", "edgeLabelBackground": "#ffffff"}, "flowchart": {"curve": "basis", "nodeSpacing": 42, "rankSpacing": 58}}}%%
flowchart TB
    subgraph LIVE["Live ACP session"]
        direction LR
        CONFIG["Configured agent<br/>command · ACP profile · probe"]
        PREFLIGHT{"Authority preflight<br/>no sandbox · yolo · sudo"}
        CONTROL{"Control deadline · 30s<br/>lock · bounded queue · receipt"}
        ACTOR["Session actor<br/>active run only"]
        MAILBOX["Actor signal mailbox<br/>128 events · async backpressure<br/>fatal watch bypass"]
        ACP["ACP subprocess<br/>one process group<br/>stdout ≤ 16 MiB / frame"]
        CONFIG --> PREFLIGHT
        PREFLIGHT -->|"verified"| CONTROL --> ACTOR
        ACTOR -->|"ACP requests"| ACP
        ACP -->|"bounded JSON-RPC frames<br/>responses · idle"| MAILBOX --> ACTOR
        ACTOR -->|"queue · steer · cancel"| ACP
    end
    subgraph DURABLE["Exactly-once run boundary"]
        direction LR
        ENDED{"Run ended<br/>native terminal stored?"}
        FALLBACK["Crab lifecycle fallback<br/>crab/run_finished"]
        DB[("SQLite journal + prompt FIFO<br/>sessions · prompts<br/>events · permissions")]
        PAGE["Cursor page<br/>≤ 1,000 whole events<br/>≤ 16 MiB + 64 KiB retained"]
        UI["Native channel / UI<br/>lossless event view"]
        ENDED -->|"yes"| DB
        ENDED -->|"no · error"| FALLBACK
        FALLBACK -->|"same transaction"| DB
        DB -->|"stream rows"| PAGE -->|"stable cursor"| UI
    end

    ACTOR --> ENDED
    ACTOR <-->|"transactional state · next queued"| DB
    ACP -->|"raw output stored first"| DB
    UI -->|"non-blocking input<br/>2 MiB native prompt cap"| CONTROL

    classDef config fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#172033;
    classDef gate fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f;
    classDef runtime fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#172554;
    classDef fallback fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;
    classDef durable fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d;
    classDef ui fill:#f3e8ff,stroke:#9333ea,stroke-width:2px,color:#581c87;

    class CONFIG config;
    class PREFLIGHT,CONTROL gate;
    class ACTOR,MAILBOX,ACP runtime;
    class FALLBACK fallback;
    class ENDED gate;
    class DB,PAGE durable;
    class UI ui;
