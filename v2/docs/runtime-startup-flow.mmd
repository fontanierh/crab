%%{init: {"theme": "base", "themeVariables": {"fontFamily": "ui-sans-serif, system-ui, sans-serif", "primaryTextColor": "#172033", "lineColor": "#64748b", "edgeLabelBackground": "#ffffff"}, "flowchart": {"curve": "basis", "nodeSpacing": 42, "rankSpacing": 54}}}%%
flowchart LR
    CONFIG["strict JSON topology<br/>secret names, never values"]
    STATE[("six SQLite stores<br/>private state directory")]
    IPC["owner-only local IPC<br/>persistent token · ephemeral socket"]
    UI["native UI adapter"]
    TRIGGER["cron · self-work · operator<br/>crab-v2-trigger"]
    ATTACH["channel-gateway<br/>idempotent attach"]
    INBOX["trigger-inbox.enqueue<br/>durable · idempotent"]
    RECOVER{"matching binding?"}
    REUSE["reuse live session"]
    REBIND["open once · replace unavailable"]
    BIND["open once · create binding"]
    ROUTE["CAS target → lane → binding"]
    WORKER["one bounded worker / lane<br/>claim · route · settle · repeat"]
    SIGNAL["SIGINT / SIGTERM<br/>stop workers · close sessions"]

    CONFIG --> ATTACH
    UI --> IPC --> ATTACH
    TRIGGER --> IPC --> INBOX --> WORKER
    STATE --> RECOVER
    ATTACH --> RECOVER
    RECOVER -->|"live + same"| REUSE
    RECOVER -->|"unavailable"| REBIND
    RECOVER -->|"no"| BIND
    REUSE --> ROUTE
    REBIND --> ROUTE
    BIND --> ROUTE
    ROUTE --> WORKER
    STATE --> IPC
    WORKER --> SIGNAL
    IPC --> SIGNAL

    classDef config fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#172033;
    classDef durable fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d;
    classDef agent fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#2e1065;
    classDef runtime fill:#ffedd5,stroke:#ea580c,stroke-width:2px,color:#7c2d12;
    class CONFIG,UI,TRIGGER,SIGNAL config;
    class STATE,IPC durable;
    class ATTACH agent;
    class RECOVER,REUSE,REBIND,BIND,ROUTE,INBOX,WORKER runtime;
