%%{init: {"theme": "base", "themeVariables": {"fontFamily": "ui-sans-serif, system-ui, sans-serif", "primaryTextColor": "#172033", "lineColor": "#64748b", "clusterBkg": "#f8fafc", "clusterBorder": "#cbd5e1", "edgeLabelBackground": "#ffffff"}, "flowchart": {"curve": "basis", "nodeSpacing": 42, "rankSpacing": 58}}}%%
flowchart TB
    UI["Native ACP UI<br/>plug in or build"]
    IPC["owner-only local IPC<br/>Boxology JSON"]
    WHATSAPP["WhatsApp"]
    WAPROVIDER["whatsapp-bridge-provider<br/>first-party provider package"]
    RUNTIMEMANIFEST["runtime/boxology.toml<br/>provider selection"]

    BRIDGE["bridge-host"]
    TRIGGER["trigger-inbox"]
    ROUTER["turn-router"]
    GATEWAY["channel-gateway"]
    CHANNEL["native-channel"]
    AGENT["agent-host<br/>ACP"]
    SUBAGENT["sub-agent-host"]
    CONTROL["runtime-control<br/>config + process attestation"]

    CHILDREN["ACP harness<br/>subprocesses"]
    AUTH["Mandatory authority<br/>no sandbox · yolo permissions<br/>unrestricted FS + network · verified sudo"]

    UI <-->|"authenticated · versioned"| IPC
    IPC -->|"status"| CONTROL
    IPC -->|"attach"| GATEWAY
    IPC <-->|"turn · interrupt · status · replay"| CHANNEL
    GATEWAY -->|"binding lifecycle"| CHANNEL
    GATEWAY -->|"open · status · close"| AGENT
    CHANNEL -->|"queue · steer<br/>explicit interrupt"| AGENT
    AGENT -->|"messages · tools · state<br/>compaction when reported"| CHANNEL

    AGENT <-->|"non-blocking messages"| SUBAGENT
    SUBAGENT <-->|"fresh or inherited context<br/>one process per child"| CHILDREN

    WHATSAPP <-->|"Baileys"| WAPROVIDER
    WAPROVIDER <-->|"bridge protocol v2"| BRIDGE
    RUNTIMEMANIFEST -. "metadata only · not binding" .-> WAPROVIDER
    BRIDGE -->|"queue · steer · interrupt<br/>fixed at registration"| TRIGGER
    TRIGGER -->|"leased triggers"| ROUTER
    ROUTER -->|"resolved + settled turns"| CHANNEL
    AUTH -. "fail-closed preflight" .-> AGENT
    AUTH -. "same authority" .-> SUBAGENT

    classDef agent fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#2e1065;
    classDef channel fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#172554;
    classDef bridge fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d;
    classDef provider fill:#ccfbf1,stroke:#0f766e,stroke-width:2px,color:#134e4a;
    classDef topology fill:#e0f2fe,stroke:#0284c7,stroke-width:1.5px,color:#0c4a6e;
    classDef trigger fill:#ffedd5,stroke:#ea580c,stroke-width:2px,color:#7c2d12;
    classDef router fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f;
    classDef subagent fill:#fce7f3,stroke:#db2777,stroke-width:2px,color:#831843;
    classDef external fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#172033;
    classDef authority fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    class AGENT agent;
    class SUBAGENT subagent;
    class CHANNEL,IPC,CONTROL channel;
    class GATEWAY channel;
    class BRIDGE bridge;
    class WAPROVIDER provider;
    class RUNTIMEMANIFEST topology;
    class TRIGGER trigger;
    class ROUTER router;
    class UI,WHATSAPP,CHILDREN external;
    class AUTH authority;
