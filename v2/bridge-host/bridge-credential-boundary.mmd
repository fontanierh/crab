flowchart LR
    INITIAL["Initial authentication<br/>credential"]
    LIVE["Live package<br/>credential rotation"]
    ADMIT{"Snapshot admission<br/>valid JSON · ≤ 8 MiB"}
    REJECT["Reject<br/>no lock or write"]
    SERIAL["Credential update<br/>serialization"]
    CAS{"Prior fingerprint<br/>still current?"}
    PROVIDER[("Opaque credential<br/>provider")]
    HANDLE[("Bridge state<br/>handle only")]

    INITIAL --> ADMIT
    LIVE --> ADMIT
    ADMIT -->|"malformed / oversized"| REJECT
    ADMIT -->|"initial"| PROVIDER
    ADMIT -->|"valid live update"| SERIAL --> CAS
    CAS -->|"stale"| REJECT
    CAS -->|"match"| PROVIDER
    PROVIDER -->|"opaque handle"| HANDLE

    classDef source fill:#f3e8ff,stroke:#9333ea,stroke-width:2px,color:#581c87;
    classDef runtime fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#172554;
    classDef durable fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d;
    classDef gate fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f;
    classDef failure fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    class INITIAL,LIVE source;
    class SERIAL runtime;
    class PROVIDER,HANDLE durable;
    class ADMIT,CAS gate;
    class REJECT failure;
