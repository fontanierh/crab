flowchart LR
    STORE[("Durable bridge catalog<br/>active + tombstones")]

    subgraph LEGACY["Compatibility view"]
        PRIORITY["Active first<br/>identity ordered"]
        CAP["At most 256 records"]
    end

    subgraph PAGE["Paged audit view"]
        INPUT{"Request gate<br/>cursor ≤ 512 B<br/>1 ≤ limit ≤ 256"}
        FILTER["Optional active-only filter"]
        KEYSET["Identity keyset<br/>bridge_id > cursor"]
        WINDOW["Read limit + 1"]
        RESULT["≤ 256 records<br/>total + next cursor"]
    end

    REJECT["InvalidSpec<br/>before storage"]
    STORE --> PRIORITY --> CAP
    INPUT -->|"invalid"| REJECT
    INPUT -->|"valid"| FILTER --> KEYSET
    STORE --> KEYSET --> WINDOW --> RESULT

