flowchart LR
    PACKAGE["Bridge package<br/>result"]
    FRAME["Protocol frame<br/>≤ 16 MiB"]
    ADMIT{"Semantic result gate<br/>detail · presentation · IDs"}
    REJECT["Protocol failure / retry<br/>no durable write"]
    KIND{"Result kind"}
    HEALTH[("Latest health<br/>snapshot")]
    AUTH[("Credential status /<br/>operator presentation")]
    DELIVERY[("Durable delivery<br/>receipt")]

    PACKAGE --> FRAME --> ADMIT
    ADMIT -->|"over limit / invalid JSON"| REJECT
    ADMIT -->|"within limit"| KIND
    KIND -->|"health"| HEALTH
    KIND -->|"authentication"| AUTH
    KIND -->|"delivery"| DELIVERY

